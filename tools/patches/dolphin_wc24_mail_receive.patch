+  EXPECT_EQ(list.AddMessage({}), WC24_ERR_BROKEN);
+  EXPECT_EQ(list.AddMessage(std::vector<u8>(208953)), WC24_ERR_BROKEN);
+  ASSERT_EQ(m_fs->Delete(PID_KD, PID_KD, CTL), FS::ResultCode::Success);
+  EXPECT_EQ(list.AddMessage(Message("one")), WC24_ERR_BROKEN);
+}
