+TEST_F(WC24ReceiveTest, StoresLogicalMessageAndAlignedVffFile)
+{
+  WC24ReceiveList list{m_fs};
+  ASSERT_FALSE(list.IsDisabled());
+  const auto message = Message("one");
+  ASSERT_EQ(list.AddMessage(message), WC24_OK);
+  EXPECT_EQ(list.GetNumberOfMail(), 1u);
+  std::vector<u8> stored((message.size() + 31) & ~size_t{31});
+  ASSERT_EQ(ReadFromVFF(RECEIVE_BOX_PATH, "mb/r0000001.msg", m_fs, stored), WC24_OK);
+  EXPECT_TRUE(std::equal(message.begin(), message.end(), stored.begin()));
+  WC24ReceiveList reopened{m_fs};
+  EXPECT_FALSE(reopened.IsDisabled());
+  EXPECT_EQ(reopened.GetNumberOfMail(), 1u);
+}
+
+TEST_F(WC24ReceiveTest, ReplayedBatchDoesNotDuplicateMessageIds)
+{
+  WC24ReceiveList list{m_fs};
+  ASSERT_EQ(list.AddMessage(Message("one")), WC24_OK);
+  ASSERT_EQ(list.AddMessage(Message("two")), WC24_OK);
+  WC24ReceiveList reopened{m_fs};
+  ASSERT_EQ(reopened.AddMessage(Message("one")), WC24_OK);
+  ASSERT_EQ(reopened.AddMessage(Message("two")), WC24_OK);
+  EXPECT_EQ(reopened.GetNumberOfMail(), 2u);
+  // A legitimate new notice with equal body gets its own entry.
+  ASSERT_EQ(reopened.AddMessage(Message("three")), WC24_OK);
+  EXPECT_EQ(reopened.GetNumberOfMail(), 3u);
+}
