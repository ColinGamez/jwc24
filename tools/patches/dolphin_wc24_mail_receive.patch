+
+// Returned views borrow response storage; no mailbox or account access is performed.
+std::optional<std::vector<std::string_view>> ParseReceiveEnvelope(std::string_view content_type,
+                                                                  std::string_view response);
+
+class WC24ReceiveList final
+{
+public:
+  explicit WC24ReceiveList(std::shared_ptr<FS::FileSystem> fs);
+
+  bool IsDisabled() const;
+  u32 GetNumberOfMail() const;
+  bool ReadReceiveList();
+  bool WriteReceiveList() const;
+  ErrorCode AddMessage(std::span<const u8> message);
+  u32 ProcessFriendRegistrationMessages(WC24FriendList& friend_list);
+
+private:
+  static constexpr u32 MAX_ENTRIES = 255;
+  static constexpr u32 RECEIVE_LIST_SIZE = 32768;
+
+#pragma pack(push, 1)
+  struct ReceiveList final
+  {
+    MailListHeader header;
+    std::array<MailListEntry, MAX_ENTRIES> entries;
+  };
+  static_assert(sizeof(ReceiveList) == RECEIVE_LIST_SIZE);
+#pragma pack(pop)
+
+  u32 GetEntryId(u32 index) const;
+  u32 GetNextEntryId() const;
+  u32 GetNextEntryIndex() const;
+  std::string GetMailPath(u32 index) const;
+  void RefreshQueuedMessageMetadata();
+
+  ReceiveList m_data{};
+  std::shared_ptr<FS::FileSystem> m_fs;
+  bool m_is_disabled = false;
+};
+}  // namespace NWC24::Mail
+}  // namespace IOS::HLE
