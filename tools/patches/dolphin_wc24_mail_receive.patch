+TEST_F(WC24ReceiveTest, LegacyRegistrationIdsAreScopedBySender)
+{
+  WC24ReceiveList list{m_fs};
+  auto first = Message("legacy");
+  auto second = first;
+  // Mutate one sender address byte, preserving the legacy reused Message-ID.
+  const auto at = std::search(second.begin(), second.end(), "example@", "example@" + 8);
+  ASSERT_NE(at, second.end());
+  *at = 'z';
+  EXPECT_EQ(list.AddMessage(first), WC24_OK);
+  EXPECT_EQ(list.AddMessage(second), WC24_OK);
+  EXPECT_EQ(list.GetNumberOfMail(), 2u);
+}
