+NWC24::ErrorCode NetKDRequestDevice::KDReceiveMail()
+{
+  // Explicit ioctl requests and the scheduler share the mailbox, friend list and HTTP client.
+  std::lock_guard mail_lg(m_mail_lock);
+  {
+    std::lock_guard lg(m_scheduler_buffer_lock);
+    m_scheduler_buffer[4] = Common::swap32(static_cast<u32>(CurrentFunction::Receive));
+  }
+  Common::ScopeGuard state_guard([&] {
+    std::lock_guard lg(m_scheduler_buffer_lock);
+    m_scheduler_buffer[4] = static_cast<u32>(CurrentFunction::None);
+  });
+
+  const Common::HttpRequest::Headers form_headers = {
+      {"Content-Type", "application/x-www-form-urlencoded"}};
+  const std::string form_data =
+      fmt::format("mlid=w{:016}&passwd={}&maxsize={}", m_config.Id(), m_config.GetPassword(),
+                  MAX_MAIL_SIZE);
+  const Common::HttpRequest::Response response =
+      m_http.Post(m_config.GetReceiveURL(), form_data, form_headers);
+  if (!response)
+  {
+    ERROR_LOG_FMT(IOS_WC24, "NET_KD_REQ: Failed to receive mail from {}.",
+                  m_config.GetReceiveURL());
+    return NWC24::WC24_ERR_SERVER;
+  }
+
+  const std::string response_str{response->begin(), response->end()};
+  const auto parsed = NWC24::Mail::ParseReceiveEnvelope(m_http.GetHeaderValue("Content-Type"), response_str);
+  if (!parsed || GetValueFromCGIResponse(std::string{parsed->front()}, "cd") != "100")
+    return NWC24::WC24_ERR_SERVER;
+  const auto& bodies = *parsed;
+
+  u32 received = 0;
+  for (const std::string_view body : std::span{bodies}.subspan(1))
+  {
+    const std::span message{reinterpret_cast<const u8*>(body.data()), body.size()};
+    const NWC24::ErrorCode result = m_receive_list.AddMessage(message);
+    if (result != NWC24::WC24_OK)
+      return result;
+    ++received;
+  }
+
+  m_receive_list.ProcessFriendRegistrationMessages(m_friend_list);
+
+  if (received != 0)
+  {
+    const std::string delete_form =
+        fmt::format("mlid=w{:016}&passwd={}&delnum={}", m_config.Id(), m_config.GetPassword(),
+                    received);
+    const Common::HttpRequest::Response delete_response =
+        m_http.Post(m_config.GetDeleteURL(), delete_form, form_headers);
+    if (!delete_response ||
+        GetValueFromCGIResponse(std::string{delete_response->begin(), delete_response->end()},
+                                "cd") != "100")
+    {
+      return NWC24::WC24_ERR_SERVER;
+    }
+
+    // NWC24iGetSchedulerStat forwards this flag into the title-side NWC24 library.
+    // The Wii Menu uses both bits to recognize newly received Message Board mail.
+    constexpr u32 MSG_ARRIVED = 1 << 0;
+    constexpr u32 MSG_ARRIVED_FOR_MENU = 1 << 1;
+    std::lock_guard lg(m_scheduler_buffer_lock);
+    m_scheduler_buffer[3] = Common::swap32(MSG_ARRIVED | MSG_ARRIVED_FOR_MENU);
+    m_scheduler_buffer[7] =
+        Common::swap32(Common::swap32(m_scheduler_buffer[7]) + received);
+    m_scheduler_buffer[12] = Common::swap32(Common::swap32(m_scheduler_buffer[12]) + 1);
+  }
+
+  if (!m_pending_mail_flag.empty())
+  {
+    m_send_list.SetMailFlag(m_pending_mail_flag);
+    m_send_list.WriteSendList();
+  }
+  NOTICE_LOG_FMT(IOS_WC24, "Received {} Wii Mail message(s).", received);
+  return NWC24::WC24_OK;
+}
