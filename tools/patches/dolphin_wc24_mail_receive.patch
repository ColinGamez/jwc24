+// Faults are injected at the emulated FS boundary, since HostFileSystem deliberately
+// ignores mode metadata. All backing files still live in a fresh temporary profile.
+class FaultFileSystem final : public FS::FileSystem
+{
+public:
+  explicit FaultFileSystem(std::shared_ptr<FS::FileSystem> fs) : inner{std::move(fs)} {}
+  std::string blocked_write;
+  bool short_write = false;
+  void DoState(PointerWrap& p) override { inner->DoState(p); }
+  FS::ResultCode Format(FS::Uid u) override { return inner->Format(u); }
+  FS::Result<FS::FileHandle> OpenFile(FS::Uid u, FS::Gid g, const std::string& p, FS::Mode m) override
+  {
+    auto file = inner->OpenFile(u, g, p, m);
+    if (!file)
+      return std::unexpected{file.error()};
+    const auto fd = file->Release();
+    paths[fd] = p;
+    return FS::FileHandle{this, fd};
+  }
+  FS::ResultCode Close(FS::Fd f) override { paths.erase(f); return inner->Close(f); }
+  FS::Result<u32> ReadBytesFromFile(FS::Fd f, u8* p, u32 n) override
+  { return inner->ReadBytesFromFile(f, p, n); }
+  FS::Result<u32> WriteBytesToFile(FS::Fd f, const u8* p, u32 n) override
+  {
+    if (paths[f] == blocked_write)
+    {
+      if (short_write)
+        return u32{0};
+      return std::unexpected{FS::ResultCode::NoFreeSpace};
+    }
+    return inner->WriteBytesToFile(f, p, n);
+  }
+  FS::Result<u32> SeekFile(FS::Fd f, u32 n, FS::SeekMode m) override
+  { return inner->SeekFile(f, n, m); }
+  FS::Result<FS::FileStatus> GetFileStatus(FS::Fd f) override { return inner->GetFileStatus(f); }
+  FS::ResultCode CreateFile(FS::Uid u, FS::Gid g, const std::string& p, FS::FileAttribute a, FS::Modes m) override
+  { return inner->CreateFile(u, g, p, a, m); }
+  FS::ResultCode CreateDirectory(FS::Uid u, FS::Gid g, const std::string& p, FS::FileAttribute a, FS::Modes m) override
+  { return inner->CreateDirectory(u, g, p, a, m); }
+  FS::ResultCode Delete(FS::Uid u, FS::Gid g, const std::string& p) override
+  { return inner->Delete(u, g, p); }
+  FS::ResultCode Rename(FS::Uid u, FS::Gid g, const std::string& p, const std::string& q) override
+  { return inner->Rename(u, g, p, q); }
+  FS::Result<std::vector<std::string>> ReadDirectory(FS::Uid u, FS::Gid g, const std::string& p) override
+  { return inner->ReadDirectory(u, g, p); }
+  FS::Result<FS::Metadata> GetMetadata(FS::Uid u, FS::Gid g, const std::string& p) override
+  { return inner->GetMetadata(u, g, p); }
+  FS::ResultCode SetMetadata(FS::Uid u, const std::string& p, FS::Uid v, FS::Gid g, FS::FileAttribute a, FS::Modes m) override
+  { return inner->SetMetadata(u, p, v, g, a, m); }
+  FS::Result<FS::NandStats> GetNandStats() override { return inner->GetNandStats(); }
+  FS::Result<FS::DirectoryStats> GetDirectoryStats(const std::string& p) override
+  { return inner->GetDirectoryStats(p); }
+  FS::Result<FS::ExtendedDirectoryStats> GetExtendedDirectoryStats(const std::string& p) override
+  { return inner->GetExtendedDirectoryStats(p); }
+  void SetNandRedirects(std::vector<FS::NandRedirect> r) override
+  { inner->SetNandRedirects(std::move(r)); }
+private:
+  std::shared_ptr<FS::FileSystem> inner;
+  std::map<FS::Fd, std::string> paths;
+};
+
+class WC24ReceiveTest : public testing::Test
+{
+protected:
+  void SetUp() override
+  {
+    m_temp = File::CreateTempDir();
+    ASSERT_FALSE(m_temp.empty());
+    UICommon::SetUserDirectory(m_temp);
+    m_faults = std::make_shared<FaultFileSystem>(Kernel{}.GetFS());
+    m_fs = m_faults;
+    ASSERT_EQ(m_fs->CreateFullPath(PID_KD, PID_KD, CTL, 0, RW), FS::ResultCode::Success);
+    std::array<u8, 32768> ctl{};
+    MailListHeader header{};
+    header.magic = Common::swap32(MAIL_LIST_MAGIC);
+    header.version = Common::swap32(4);
+    header.total_entries = Common::swap32(255);
+    header.filesize = Common::swap32(32768);
+    header.next_entry_id = Common::swap32(1);
+    header.next_entry_offset = CalculateFileOffset(0);
+    std::memcpy(ctl.data(), &header, sizeof(header));
+    auto file = m_fs->CreateAndOpenFile(PID_KD, PID_KD, CTL, RW);
+    ASSERT_TRUE(file);
+    ASSERT_TRUE(file->Write(ctl.data(), ctl.size()));
+
+    // Generated, empty FAT12 VFF: no console files, credentials or Nintendo messages.
+    constexpr u32 volume_size = 1024 * 1024;
+    std::vector<u8> vff(volume_size - 480);
+    VFFHeader vff_header{};
+    std::memcpy(vff_header.magic, "VFF ", 4);
+    vff_header.endianness = Common::swap16(VF_BIG_ENDIAN);
+    vff_header.volume_size = Common::swap32(volume_size);
+    vff_header.cluster_size = Common::swap16(32);
+    std::memcpy(vff.data(), &vff_header, sizeof(vff_header));
+    for (const u32 fat_sector : {1u, 7u})
+    {
+      const u32 offset = fat_sector * 512 - 480;
+      // FAT12 reserved entries plus directory cluster 2, all end-of-chain.
+      const std::array<u8, 5> fat{0xf8, 0xff, 0xff, 0xff, 0x0f};
+      std::memcpy(vff.data() + offset, fat.data(), fat.size());
+    }
+    const u32 root = 13 * 512 - 480;
+    std::memcpy(vff.data() + root, "MB         ", 11);
+    vff[root + 11] = 0x10;  // directory attribute
+    vff[root + 26] = 2;     // first cluster (little endian)
+    auto box = m_fs->CreateAndOpenFile(PID_KD, PID_KD, RECEIVE_BOX_PATH, RW);
+    ASSERT_TRUE(box);
+    ASSERT_TRUE(box->Write(vff.data(), vff.size()));
+  }
+  void TearDown() override
+  {
+    m_fs.reset();
+    m_faults.reset();
+    if (!m_temp.empty())
+      File::DeleteDirRecursively(m_temp);
+  }
+  static std::vector<u8> Message(std::string id, std::string body = "test")
+  {
+    const std::string text = "Message-ID: <" + id + ">\r\nFrom: example@example.invalid\r\n"
+      "To: w0000000000000000@example.invalid\r\nContent-Type: text/plain; charset=utf-8\r\n"
+      "Content-Transfer-Encoding: 8bit\r\n\r\n" + body;
+    return {text.begin(), text.end()};
+  }
+  std::shared_ptr<FaultFileSystem> m_faults;
+  std::shared_ptr<FS::FileSystem> m_fs;
+  std::string m_temp;
+};
