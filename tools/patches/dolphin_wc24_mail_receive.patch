+TEST(WC24ReceiveEnvelopeTest, CompleteQuotedBoundaryAndBinaryMessage)
+{
+  const std::string response = "--abc\r\nContent-Type: text/plain\r\n\r\ncd=100\r\n"
+    "--abc\r\nContent-Type: message/rfc822\r\n\r\nFrom: test\r\n\r\nbody\r\n--abc--\r\n";
+  const auto parsed = ParseReceiveEnvelope("Multipart/Mixed; charset=utf-8; Boundary=\"abc\"", response);
+  ASSERT_TRUE(parsed);
+  ASSERT_EQ(parsed->size(), 2u);
+  EXPECT_EQ((*parsed)[0], "cd=100");
+  EXPECT_EQ((*parsed)[1], "From: test\r\n\r\nbody");
+}
+
+TEST(WC24ReceiveEnvelopeTest, BoundarySubstringAndPrefixedLinesRemainMessageData)
+{
+  const std::string body = "header\r\n\r\ninline --abc here\r\n--abc-extra\r\nlast";
+  const std::string response = "--abc\r\nContent-Type: message/rfc822\r\n\r\n" + body + "\r\n--abc--";
+  const auto parsed = ParseReceiveEnvelope("multipart/mixed; boundary=abc", response);
+  ASSERT_TRUE(parsed);
+  ASSERT_EQ(parsed->size(), 1u);
+  EXPECT_EQ(parsed->front(), body);
+}
+
+TEST(WC24ReceiveEnvelopeTest, TruncatedOrAmbiguousFramingCannotBeAcknowledged)
+{
+  const std::string part = "--abc\r\nContent-Type: text/plain\r\n\r\ncd=100\r\n";
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=abc", part));
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=abc", part + "--abc--garbage"));
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=abc; boundary=def", part));
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=\"abc", part));
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=", part));
+  EXPECT_FALSE(ParseReceiveEnvelope("text/plain; boundary=abc", part));
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=abc", "--abc--\r\n"));
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=abc", "--abc\r\n--abc--\r\n"));
+}
+
+TEST(WC24ReceiveEnvelopeTest, InputBoundsAndEmbeddedNul)
+{
+  const std::string body{"x\0y", 3};
+  const std::string response = "--abc\r\nContent-Type: text/plain\r\n\r\n" + body + "\r\n--abc--\r\n";
+  const auto parsed = ParseReceiveEnvelope("multipart/mixed; boundary=abc", response);
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ(parsed->front(), body);
+  EXPECT_FALSE(ParseReceiveEnvelope(std::string(1025, 'x'), response));
+  EXPECT_FALSE(ParseReceiveEnvelope("multipart/mixed; boundary=abc", std::string(4 * 1024 * 1024 + 1, 'x')));
+}
