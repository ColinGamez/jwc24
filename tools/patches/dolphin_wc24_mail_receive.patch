+TEST_F(WC24ReceiveTest, ConflictingMessageIdCannotBeAcknowledged)
+{
+  WC24ReceiveList list{m_fs};
+  ASSERT_EQ(list.AddMessage(Message("one")), WC24_OK);
+  EXPECT_EQ(list.AddMessage(Message("one", "changed")), WC24_ERR_BROKEN);
