+TEST_F(WC24ReceiveTest, FriendConfirmationRequiresPersistedStatus)
+{
+  std::array<u8, 32864> friends{};
+  const auto put32 = [&](size_t offset, u32 value) {
+    value = Common::swap32(value);
+    std::memcpy(friends.data() + offset, &value, sizeof(value));
+  };
+  put32(0, 0x5763466c);
+  put32(4, 2);
+  put32(8, 100);
+  put32(12, 1);
+  const u64 code = Common::swap64(1234567890123456ULL);
+  std::memcpy(friends.data() + 64, &code, sizeof(code));
+  put32(864, 1);  // Wii friend
+  put32(868, 1);  // unconfirmed
+  {
+    auto file = m_fs->CreateAndOpenFile(PID_KD, PID_KD, FRIEND_LIST_PATH, RW);
+    ASSERT_TRUE(file);
+    ASSERT_TRUE(file->Write(friends.data(), friends.size()));
+  }
+  WC24FriendList list{m_fs};
+  m_faults->blocked_write = FRIEND_LIST_PATH;
+  EXPECT_FALSE(list.ConfirmFriend(1234567890123456ULL));
+  EXPECT_EQ(list.GetUnconfirmedFriends().size(), 1u);
+  m_faults->blocked_write.clear();
+  EXPECT_TRUE(list.ConfirmFriend(1234567890123456ULL));
+  WC24FriendList reopened{m_fs};
+  EXPECT_TRUE(reopened.GetUnconfirmedFriends().empty());
+  EXPECT_TRUE(reopened.ConfirmFriend(1234567890123456ULL));
+  ASSERT_EQ(m_fs->Delete(PID_KD, PID_KD, FRIEND_LIST_PATH), FS::ResultCode::Success);
+  EXPECT_FALSE(reopened.ConfirmFriend(1234567890123456ULL));
+}
