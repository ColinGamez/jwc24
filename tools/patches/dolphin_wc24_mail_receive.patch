+
+namespace
+{
+constexpr u32 MSG_FOR_RECIPIENT = 1 << 0;
+constexpr u32 MSG_FOR_PUBLIC = 1 << 1;
+constexpr u32 MSG_FOR_APP = 1 << 2;
+constexpr u32 MSG_FOR_MENU = 1 << 3;
+constexpr u32 MSG_TO_RECV = 1 << 5;
+constexpr u32 MSG_INITIALIZED = 1 << 8;
+constexpr u32 MSG_DELIVERING = 1 << 9;
+// RevoEX (used by Wii Menu 4.x) marks initialized message objects with this
+// additional type bit. NWC24GetMsgObj rejects entries created without it.
+constexpr u32 MSG_REVOEX_TYPE = 1 << 21;
+
+struct FieldLocation
+{
+  u32 offset = 0;
+  u32 size = 0;
+};
+
+FieldLocation FindHeader(std::string_view message, std::string_view name)
+{
+  const size_t headers_end = message.find("\r\n\r\n");
+  if (headers_end == std::string_view::npos)
+    return {};
+
+  size_t line_start = 0;
+  while (line_start < headers_end)
+  {
+    const size_t line_end = message.find("\r\n", line_start);
+    const std::string_view line = message.substr(line_start, line_end - line_start);
+    if (line.size() > name.size() + 1 &&
+        std::equal(name.begin(), name.end(), line.begin(),
+                   [](char lhs, char rhs) {
+                     return std::tolower(static_cast<unsigned char>(lhs)) ==
+                            std::tolower(static_cast<unsigned char>(rhs));
+                   }) &&
+        line[name.size()] == ':')
+    {
+      size_t value_start = name.size() + 1;
+      while (value_start < line.size() && line[value_start] == ' ')
+        ++value_start;
+      return {static_cast<u32>(line_start + value_start),
+              static_cast<u32>(line.size() - value_start)};
+    }
+    if (line_end == std::string_view::npos)
+      break;
+    line_start = line_end + 2;
+  }
+  return {};
+}
+
+FieldLocation FindHeaderInRange(std::string_view message, size_t headers_start,
+                                size_t headers_end, std::string_view name)
+{
+  size_t line_start = headers_start;
+  while (line_start < headers_end)
+  {
+    const size_t line_end = std::min(message.find("\r\n", line_start), headers_end);
+    const std::string_view line = message.substr(line_start, line_end - line_start);
+    if (line.size() > name.size() + 1 &&
+        std::equal(name.begin(), name.end(), line.begin(),
+                   [](char lhs, char rhs) {
+                     return std::tolower(static_cast<unsigned char>(lhs)) ==
+                            std::tolower(static_cast<unsigned char>(rhs));
+                   }) &&
+        line[name.size()] == ':')
+    {
+      size_t value_start = name.size() + 1;
+      while (value_start < line.size() && line[value_start] == ' ')
+        ++value_start;
+      return {static_cast<u32>(line_start + value_start),
+              static_cast<u32>(line.size() - value_start)};
+    }
+    if (line_end == headers_end)
+      break;
+    line_start = line_end + 2;
+  }
+  return {};
+}
+
+FieldLocation FindParameter(std::string_view message, FieldLocation field,
+                            std::string_view name)
+{
+  const std::string_view value =
+      field.size == 0 ? std::string_view{} : message.substr(field.offset, field.size);
+  size_t position = value.find(name);
+  if (position == std::string_view::npos)
+    return {};
+
+  position += name.size();
+  // RFC mail generators commonly quote parameter values (for example,
+  // charset="utf-16be").  RevoEX accepts a trailing delimiter because its
+  // parser performs a case-insensitive prefix match, but a leading quote
+  // prevents the charset from being recognized at all.
+  if (position < value.size() && value[position] == '"')
+    ++position;
+  size_t end = position;
+  while (end < value.size() && value[end] != '"' && value[end] != ';' && value[end] != '\r' &&
+         value[end] != '\n' && !std::isspace(static_cast<unsigned char>(value[end])))
+  {
+    ++end;
+  }
+
+  if (end == position)
+    return {};
+
+  // Nintendo's message library includes the following delimiter byte in the
+  // packed charset/encoding length so its temporary copy is terminated.
+  return {field.offset + static_cast<u32>(position), static_cast<u32>(end - position + 1)};
+}
+
+u32 PackField(FieldLocation field)
+{
+  return (field.offset & 0x000fffff) | ((field.size << 20) & 0xfff00000);
+}
+
+std::string_view GetField(std::string_view message, FieldLocation field)
+{
+  return field.size == 0 ? std::string_view{} : message.substr(field.offset, field.size);
+}
+
+u64 ParseWiiAddress(std::string_view value)
+{
+  const size_t marker = value.find('w');
+  if (marker == std::string_view::npos || marker + 17 > value.size())
+    return 0;
+
+  u64 id = 0;
+  const char* begin = value.data() + marker + 1;
+  const auto [end, error] = std::from_chars(begin, begin + 16, id);
+  return error == std::errc{} && end == begin + 16 ? id : 0;
+}
+
+u32 GetDecodedTextSize(std::string_view body, std::string_view encoding)
+{
+  constexpr std::string_view base64 = "base64";
+  if (encoding.size() != base64.size() ||
+      !std::equal(encoding.begin(), encoding.end(), base64.begin(),
+                  [](char lhs, char rhs) {
+                    return std::tolower(static_cast<unsigned char>(lhs)) ==
+                           std::tolower(static_cast<unsigned char>(rhs));
+                  }))
+  {
+    return static_cast<u32>(body.size());
+  }
+
+  u32 characters = 0;
+  u32 padding = 0;
+  for (const char value : body)
+  {
+    if (std::isalnum(static_cast<unsigned char>(value)) || value == '+' || value == '/')
+    {
+      ++characters;
+      padding = 0;
+    }
+    else if (value == '=')
+    {
+      ++characters;
+      ++padding;
+    }
+  }
+  return characters / 4 * 3 - std::min(padding, 2U);
+}
+
+bool EqualsIgnoringCase(std::string_view lhs, std::string_view rhs)
+{
+  return lhs.size() == rhs.size() &&
+         std::equal(lhs.begin(), lhs.end(), rhs.begin(), [](char left, char right) {
+           return std::tolower(static_cast<unsigned char>(left)) ==
+                  std::tolower(static_cast<unsigned char>(right));
+         });
+}
+
+std::string FindMultipartBoundary(std::string_view message, size_t headers_end)
+{
+  const std::string_view headers = message.substr(0, headers_end);
+  std::string lower{headers};
+  std::ranges::transform(lower, lower.begin(), [](unsigned char value) {
+    return static_cast<char>(std::tolower(value));
+  });
+  const size_t marker = lower.find("boundary=");
+  if (marker == std::string::npos)
+    return {};
+
+  size_t start = marker + 9;
+  while (start < headers.size() && std::isspace(static_cast<unsigned char>(headers[start])))
+    ++start;
+  const bool quoted = start < headers.size() && headers[start] == '"';
+  if (quoted)
+    ++start;
+  size_t end = start;
+  while (end < headers.size() &&
+         (quoted ? headers[end] != '"' : headers[end] != ';' && headers[end] != '\r' &&
+                                            headers[end] != '\n' &&
+                                            !std::isspace(static_cast<unsigned char>(headers[end]))))
+  {
+    ++end;
+  }
+  return std::string{headers.substr(start, end - start)};
+}
+
+u32 GetMimeType(std::string_view value)
+{
+  const size_t delimiter = value.find(';');
+  value = value.substr(0, delimiter);
+  while (!value.empty() && std::isspace(static_cast<unsigned char>(value.back())))
+    value.remove_suffix(1);
+
+  if (EqualsIgnoringCase(value, "image/jpeg"))
+    return 0x00020000;
+  if (EqualsIgnoringCase(value, "image/x-wii-picture"))
+    return 0x00020001;
+  if (EqualsIgnoringCase(value, "application/x-wii-msgboard"))
+    return 0x00030001;
+  if (EqualsIgnoringCase(value, "application/x-wii-minidata"))
+    return 0x00030002;
+  if (EqualsIgnoringCase(value, "text/html"))
+    return 0x00010001;
+  if (EqualsIgnoringCase(value, "text/plain"))
+    return 0x00010000;
+  return 0x00030000;
+}
+
+bool PopulateMultipartMetadata(MailListEntry* entry, std::string_view message,
+                               size_t top_headers_end)
+{
+  const std::string boundary = FindMultipartBoundary(message, top_headers_end);
+  if (boundary.empty())
+    return false;
+
+  const std::string delimiter = "--" + boundary;
+  size_t cursor = message.find(delimiter, top_headers_end + 4);
+  u8 attachment_count = 0;
+  bool found_text = false;
+  while (cursor != std::string_view::npos)
+  {
+    cursor += delimiter.size();
+    if (message.substr(cursor, 2) == "--")
+      break;
+    if (message.substr(cursor, 2) == "\r\n")
+      cursor += 2;
+
+    const size_t part_headers_end = message.find("\r\n\r\n", cursor);
+    if (part_headers_end == std::string_view::npos)
+      break;
+    const size_t body_start = part_headers_end + 4;
+    const size_t next_delimiter = message.find("\r\n" + delimiter, body_start);
+    if (next_delimiter == std::string_view::npos)
+      break;
+
+    const FieldLocation part_type =
+        FindHeaderInRange(message, cursor, part_headers_end, "Content-Type");
+    const FieldLocation part_encoding =
+        FindHeaderInRange(message, cursor, part_headers_end, "Content-Transfer-Encoding");
+    const std::string_view type = GetField(message, part_type);
+    const std::string_view encoding = GetField(message, part_encoding);
+    const u32 encoded_size = static_cast<u32>(next_delimiter - body_start);
+    const u32 decoded_size =
+        GetDecodedTextSize(message.substr(body_start, encoded_size), encoding);
+
+    if (!found_text && EqualsIgnoringCase(type.substr(0, type.find(';')), "text/plain"))
+    {
+      const FieldLocation part_charset = FindParameter(message, part_type, "charset=");
+      entry->header_length = Common::swap32(static_cast<u32>(body_start));
+      entry->packed_charset = Common::swap32(PackField(part_charset));
+      FieldLocation packed_encoding = part_encoding;
+      if (packed_encoding.size != 0)
+        ++packed_encoding.size;
+      entry->packed_transfer_encoding = Common::swap32(PackField(packed_encoding));
+      entry->message_offset = Common::swap32(static_cast<u32>(body_start));
+      entry->encoded_length = Common::swap32(encoded_size);
+      entry->message_length = Common::swap32(decoded_size);
+      found_text = true;
+    }
+    else if (attachment_count < entry->multipart_entries.size())
+    {
+      entry->multipart_entries[attachment_count].offset =
+          Common::swap32(static_cast<u32>(body_start));
+      // RevoEX's streaming base64 reader decodes complete CRLF-terminated lines. If a payload's
+      // decoded length is divisible by three, its final base64 line has no '=' padding and the
+      // reader relies on this terminating CRLF to flush that line. Include the CRLF immediately
+      // preceding the next multipart boundary in the encoded range.
+      entry->multipart_entries[attachment_count].size = Common::swap32(encoded_size + 2);
+      entry->multipart_sizes[attachment_count] = Common::swap32(decoded_size);
+      entry->multipart_content_types[attachment_count] = Common::swap32(GetMimeType(type));
+      ++attachment_count;
+    }
+
+    cursor = next_delimiter + 2;
+  }
+
+  entry->number_of_multipart_entries = attachment_count;
+  return found_text;
+}
+
+void PopulateEntryMetadata(MailListEntry* entry, std::span<const u8> raw_message)
+{
+  const std::string_view message{reinterpret_cast<const char*>(raw_message.data()),
+                                 raw_message.size()};
+  const FieldLocation from = FindHeader(message, "From");
+  const FieldLocation to = FindHeader(message, "To");
+  const FieldLocation subject = FindHeader(message, "Subject");
+  const FieldLocation content_type = FindHeader(message, "Content-Type");
+  const FieldLocation transfer_encoding = FindHeader(message, "Content-Transfer-Encoding");
+  const FieldLocation app_id = FindHeader(message, "X-Wii-AppId");
+  const FieldLocation command = FindHeader(message, "X-Wii-Cmd");
+
+  const size_t separator = message.find("\r\n\r\n");
+  const u32 body_offset =
+      separator == std::string_view::npos ? 0 : static_cast<u32>(separator + 4);
+  const u32 body_size = static_cast<u32>(message.size()) - body_offset;
+  const u32 decoded_body_size =
+      GetDecodedTextSize(message.substr(body_offset), GetField(message, transfer_encoding));
+  const FieldLocation charset = FindParameter(message, content_type, "charset=");
+
+  const u64 sender_id = ParseWiiAddress(GetField(message, from));
+  const bool is_public = sender_id == 0;
+  u32 flags = (is_public ? MSG_FOR_PUBLIC : MSG_FOR_RECIPIENT) | MSG_TO_RECV |
+              MSG_INITIALIZED | MSG_DELIVERING | MSG_REVOEX_TYPE;
+  // Public mail without X-Wii-AppId is not title-specific. RevoEX rejects a non-zero app ID
+  // whose upper 24 bits do not match the currently running title (the Wii Menu in this case).
+  u32 application = is_public ? 0 : 1;
+  u32 group = 1;
+  const std::string_view app_value = GetField(message, app_id);
+  if (!app_value.empty())
+  {
+    u32 destination = 0;
+    u32 parsed_application = 0;
+    u32 parsed_group = 0;
+    if (std::sscanf(std::string{app_value}.c_str(), "%u-%8x-%4x", &destination,
+                    &parsed_application, &parsed_group) == 3)
+    {
+      application = parsed_application;
+      group = parsed_group;
+      if (!is_public && (destination & 1))
+        flags |= MSG_FOR_APP;
+      if (!is_public && (destination & 2))
+        flags |= MSG_FOR_MENU;
+    }
+  }
+  else if (!is_public)
+  {
+    // Unscoped Wii-to-Wii letters belong to the Wii Message Board. Native Wii-composed mail
+    // normally declares destination bit 2, but replacement services may omit X-Wii-AppId.
+    flags |= MSG_FOR_MENU;
+  }
+
+  u32 command_value = 0;
+  const std::string_view command_text = GetField(message, command);
+  if (!command_text.empty())
+  {
+    const auto [end, error] = std::from_chars(command_text.data(),
+                                               command_text.data() + command_text.size(),
+                                               command_value, 16);
+    if (error != std::errc{} || end != command_text.data() + command_text.size())
+      command_value = 0;
+  }
+  // 0x8001xxxx commands are Wii Message Board friend-management messages.
+  if ((command_value & 0xffff0000) == 0x80010000)
+    flags |= MSG_FOR_MENU;
+
+  entry->flag = Common::swap32(flags);
+  entry->app_id = Common::swap32(application);
+  entry->wii_cmd = Common::swap32(command_value);
+  // NWC24CommitMsg stores the position immediately after the MIME headers here
+  // for a non-multipart message.
+  entry->header_length = Common::swap32(body_offset);
+  if (is_public)
+  {
+    // NWC24iAddr is a union: public mail stores an NWC24Data offset/size pair
+    // here, while Wii-to-Wii mail stores the numeric friend code.
+    entry->from_friend_code =
+        Common::swap64((static_cast<u64>(from.offset) << 32) | static_cast<u64>(from.size));
+  }
+  else
+  {
+    entry->from_friend_code = Common::swap64(sender_id);
+  }
+  const auto unix_minutes = std::chrono::duration_cast<std::chrono::minutes>(
+                                std::chrono::system_clock::now().time_since_epoch())
+                                .count();
+  entry->minutes_since_1900 = Common::swap32(static_cast<u32>(unix_minutes + 36816480));
+  entry->always_1 = 1;
+  entry->number_of_multipart_entries = 0;
+  entry->app_group = Common::swap16(static_cast<u16>(group));
+  entry->packed_from = Common::swap32(PackField(from));
+  entry->packed_to = Common::swap32(PackField(to));
+  entry->packed_subject = Common::swap32(PackField(subject));
+  entry->packed_charset = Common::swap32(PackField(charset));
+  FieldLocation packed_encoding = transfer_encoding;
+  if (packed_encoding.size != 0)
+    ++packed_encoding.size;
+  entry->packed_transfer_encoding = Common::swap32(PackField(packed_encoding));
+  entry->message_offset = Common::swap32(body_offset);
+  entry->encoded_length = Common::swap32(body_size);
+  entry->message_length = Common::swap32(decoded_body_size);
+  entry->always_0x80000000 = Common::swap32(0x80000000);
+
+  const std::string_view top_type = GetField(message, content_type);
+  if (separator != std::string_view::npos &&
+      top_type.size() >= std::string_view{"multipart/"}.size() &&
+      EqualsIgnoringCase(top_type.substr(0, std::string_view{"multipart/"}.size()), "multipart/"))
+  {
+    PopulateMultipartMetadata(entry, message, separator);
+  }
+}
+}  // namespace
+
+std::optional<std::vector<std::string_view>> ParseReceiveEnvelope(std::string_view content_type,
+                                                                  std::string_view response)
+{
+  if (content_type.size() > 1024 || response.size() > 4 * 1024 * 1024)
+    return std::nullopt;
+  const auto trim = [](std::string_view value) {
+    while (!value.empty() && (value.front() == ' ' || value.front() == '\t'))
+      value.remove_prefix(1);
+    while (!value.empty() && (value.back() == ' ' || value.back() == '\t'))
+      value.remove_suffix(1);
+    return value;
+  };
+  size_t cursor = content_type.find(';');
+  if (cursor == std::string_view::npos ||
+      !EqualsIgnoringCase(trim(content_type.substr(0, cursor)), "multipart/mixed"))
+    return std::nullopt;
+  std::string_view token;
+  while (cursor < content_type.size())
+  {
+    const size_t next = content_type.find(';', cursor + 1);
+    const auto parameter = trim(content_type.substr(cursor + 1, next - cursor - 1));
+    const size_t equal = parameter.find('=');
+    if (equal != std::string_view::npos &&
+        EqualsIgnoringCase(trim(parameter.substr(0, equal)), "boundary"))
+    {
+      if (!token.empty())
+        return std::nullopt;
+      token = trim(parameter.substr(equal + 1));
+      if (token.starts_with('"'))
+      {
+        if (token.size() < 2 || !token.ends_with('"'))
+          return std::nullopt;
+        token = token.substr(1, token.size() - 2);
+      }
+      if (token.empty() || token.size() > 70 ||
+          std::ranges::any_of(token, [](unsigned char c) { return c <= 32 || c >= 127 || c == '"'; }))
+        return std::nullopt;
+    }
+    cursor = next == std::string_view::npos ? content_type.size() : next;
+  }
+  if (token.empty())
+    return std::nullopt;
+  const std::string delimiter = "--" + std::string{token};
+  const auto find_delimiter = [&](size_t start) {
+    size_t position = start;
+    while ((position = response.find(delimiter, position)) != std::string_view::npos)
+    {
+      const size_t after = position + delimiter.size();
+      if ((position == 0 || (position >= 2 && response.substr(position - 2, 2) == "\r\n")) &&
+          (response.substr(after, 2) == "\r\n" || response.substr(after, 2) == "--"))
+        return position;
+      ++position;
+    }
+    return std::string_view::npos;
+  };
+  std::vector<std::string_view> parts;
+  cursor = find_delimiter(0);
+  while (cursor != std::string_view::npos)
+  {
+    cursor += delimiter.size();
+    if (response.substr(cursor, 2) == "--")
+    {
+      const auto remainder = response.substr(cursor + 2);
+      if (!remainder.empty() && !remainder.starts_with("\r\n"))
+        return std::nullopt;
+      return parts.empty() ? std::nullopt : std::make_optional(std::move(parts));
+    }
+    cursor += 2;  // delimiter CRLF
+    const size_t next = find_delimiter(cursor);
+    const size_t headers_end = response.find("\r\n\r\n", cursor);
+    if (next == std::string_view::npos || headers_end == std::string_view::npos ||
+        headers_end + 4 > next - 2 || parts.size() >= 256)
+      return std::nullopt;
+    const size_t body_start = headers_end + 4;
+    parts.push_back(response.substr(body_start, next - 2 - body_start));
+    cursor = next;
+  }
+  return std::nullopt;  // A complete closing delimiter is required before any acknowledgment.
+}
+
+WC24ReceiveList::WC24ReceiveList(std::shared_ptr<FS::FileSystem> fs) : m_fs{std::move(fs)}
+{
+  if (!ReadReceiveList())
+  {
+    ERROR_LOG_FMT(IOS_WC24, "There is an error in the WC24 receive list. Incoming mail is disabled.");
+    m_is_disabled = true;
+  }
+  else
+  {
+    RefreshQueuedMessageMetadata();
+  }
+}
+
+bool WC24ReceiveList::IsDisabled() const
+{
+  return m_is_disabled;
+}
+
+u32 WC24ReceiveList::GetNumberOfMail() const
+{
+  return Common::swap32(m_data.header.number_of_mail);
+}
+
+bool WC24ReceiveList::ReadReceiveList()
+{
+  ReceiveList data{};
+  const auto file = m_fs->OpenFile(PID_KD, PID_KD, RECEIVE_LIST_PATH, FS::Mode::Read);
+  if (!file || file->GetStatus()->size != RECEIVE_LIST_SIZE || !file->Read(&data, 1))
+    return false;
+
+  if (Common::swap32(data.header.magic) != MAIL_LIST_MAGIC ||
+      Common::swap32(data.header.version) != 4)
+    return false;
+  u32 count = 0;
+  u64 size = 0;
+  for (const auto& entry : data.entries)
+  {
+    if (entry.id == 0)
+      continue;
+    const u32 message_size = Common::swap32(entry.msg_size);
+    if (message_size == 0 || message_size > 208952)
+      return false;
+    ++count;
+    size += message_size;
+  }
+  if (count != Common::swap32(data.header.number_of_mail) ||
+      size != Common::swap32(data.header.total_size_of_messages))
+    return false;
+  m_data = data;
+  return true;
+}
+
+bool WC24ReceiveList::WriteReceiveList() const
+{
+  constexpr FS::Modes modes{FS::Mode::ReadWrite, FS::Mode::ReadWrite, FS::Mode::ReadWrite};
+  const auto file = m_fs->CreateAndOpenFile(PID_KD, PID_KD, RECEIVE_LIST_PATH, modes);
+  ReceiveList persisted{};
+  // FileHandle::Write does not expose short-write byte counts. Read the index back before
+  // allowing the caller to acknowledge (and delete) its only server-side message copy.
+  if (!file || !file->Write(&m_data, 1) ||
+      file->GetStatus()->size != RECEIVE_LIST_SIZE || !file->Seek(0, FS::SeekMode::Set) ||
+      !file->Read(&persisted, 1) || std::memcmp(&persisted, &m_data, sizeof(m_data)) != 0)
+  {
+    ERROR_LOG_FMT(IOS_WC24, "Failed to persist the WC24 receive list.");
+    return false;
+  }
+  return true;
+}
+
+u32 WC24ReceiveList::GetEntryId(u32 index) const
+{
+  return Common::swap32(m_data.entries[index].id);
+}
+
+u32 WC24ReceiveList::GetNextEntryId() const
+{
+  return Common::swap32(m_data.header.next_entry_id);
+}
+
+u32 WC24ReceiveList::GetNextEntryIndex() const
+{
+  const u32 offset = Common::swap32(m_data.header.next_entry_offset);
+  return offset >= sizeof(MailListHeader) ? (offset - sizeof(MailListHeader)) / sizeof(MailListEntry) :
+                                           0;
+}
+
+std::string WC24ReceiveList::GetMailPath(u32 index) const
+{
+  return fmt::format("mb/r{:07d}.msg", GetEntryId(index));
+}
+
+void WC24ReceiveList::RefreshQueuedMessageMetadata()
+{
+  bool changed = false;
+  for (u32 index = 0; index < MAX_ENTRIES; ++index)
+  {
+    MailListEntry& entry = m_data.entries[index];
+    const u32 message_size = Common::swap32(entry.msg_size);
+    if (GetEntryId(index) == 0 || message_size == 0)
+      continue;
+
+    std::vector<u8> message(message_size);
+    if (ReadFromVFF(RECEIVE_BOX_PATH, GetMailPath(index), m_fs, message) != WC24_OK)
+      continue;
+
+    PopulateEntryMetadata(&entry, message);
+    changed = true;
+  }
+
+  if (changed)
+    WriteReceiveList();
+}
+
+ErrorCode WC24ReceiveList::AddMessage(std::span<const u8> message)
+{
+  if (m_is_disabled || message.empty() || message.size() > 208952)
+    return WC24_ERR_BROKEN;
+
+  if (!ReadReceiveList())
+    return WC24_ERR_BROKEN;
+
+  // A failed delete.cgi or a partially imported batch is replayed by the service. Only an
+  // explicit Message-ID establishes retry identity; equal text alone can be a new notice.
+  const std::string_view text{reinterpret_cast<const char*>(message.data()), message.size()};
+  const auto message_id = GetField(text, FindHeader(text, "Message-ID"));
+  if (!message_id.empty())
+  {
+    for (u32 existing_index = 0; existing_index < MAX_ENTRIES; ++existing_index)
+    {
+      if (GetEntryId(existing_index) == 0)
+        continue;
+      std::vector<u8> existing(Common::swap32(m_data.entries[existing_index].msg_size));
+      if (ReadFromVFF(RECEIVE_BOX_PATH, GetMailPath(existing_index), m_fs, existing) != WC24_OK)
+        return WC24_ERR_FILE_READ;
+      const std::string_view existing_text{reinterpret_cast<const char*>(existing.data()),
+                                           existing.size()};
+      const auto existing_id = GetField(
+          existing_text, FindHeader(existing_text, "Message-ID"));
+      // Some older clients reuse a fixed registration ID across different friends.
+      // Scope that legacy identifier by its two envelope address headers as well.
+      if (existing_id != message_id ||
+          GetField(existing_text, FindHeader(existing_text, "From")) !=
+              GetField(text, FindHeader(text, "From")) ||
+          GetField(existing_text, FindHeader(existing_text, "To")) !=
+              GetField(text, FindHeader(text, "To")))
+        continue;
+      // Refuse conflicting reuse of an identifier rather than silently acknowledging it.
+      return std::ranges::equal(existing, message) ? WC24_OK : WC24_ERR_BROKEN;
+    }
+  }
+
+  u32 index = GetNextEntryIndex();
+  if (index >= MAX_ENTRIES || GetEntryId(index) != 0)
+  {
+    const auto free_entry = std::find_if(m_data.entries.begin(), m_data.entries.end(),
+                                         [](const MailListEntry& entry) { return entry.id == 0; });
+    if (free_entry == m_data.entries.end())
+      return WC24_ERR_FILE_WRITE;
+    index = static_cast<u32>(std::distance(m_data.entries.begin(), free_entry));
+  }
+
+  const u32 id = std::max(GetNextEntryId(), 1U);
+  MailListEntry& entry = m_data.entries[index];
+  // Free entries use app_id as a linked-list pointer and may retain other bookkeeping data.
+  // Start from a clean NWC24iMBCEntry before installing the received message metadata.
+  entry = {};
+  entry.id = Common::swap32(id);
+  entry.msg_size = Common::swap32(static_cast<u32>(message.size()));
+  PopulateEntryMetadata(&entry, message);
+
+  // RevoEX reads message files in 32-byte blocks even though the MBC entry stores the logical
+  // MIME length. Nintendo's mailbox writer therefore pads the VFF file itself to 32 bytes.
+  std::vector<u8> padded_message{message.begin(), message.end()};
+  padded_message.resize((padded_message.size() + 31) & ~size_t{31});
+  const ErrorCode result =
+      WriteToVFF(RECEIVE_BOX_PATH, GetMailPath(index), m_fs, padded_message);
+  if (result != WC24_OK)
+  {
+    entry.id = 0;
+    return result;
+  }
+
+  m_data.header.number_of_mail =
+      Common::swap32(Common::swap32(m_data.header.number_of_mail) + 1);
+  m_data.header.total_size_of_messages =
+      Common::swap32(Common::swap32(m_data.header.total_size_of_messages) +
+                     static_cast<u32>(message.size()));
+  m_data.header.next_entry_id = Common::swap32(id + 1);
+
+  u32 next_index = (index + 1) % MAX_ENTRIES;
+  for (u32 checked = 0; checked < MAX_ENTRIES && GetEntryId(next_index) != 0; ++checked)
+    next_index = (next_index + 1) % MAX_ENTRIES;
+  m_data.header.next_entry_offset = CalculateFileOffset(next_index);
+
+  if (!WriteReceiveList())
+  {
+    ReadReceiveList();
+    return WC24_ERR_FILE_WRITE;
+  }
+  return WC24_OK;
+}
+
+u32 WC24ReceiveList::ProcessFriendRegistrationMessages(WC24FriendList& friend_list)
+{
+  if (!ReadReceiveList())
+    return 0;
+  u32 processed = 0;
+  for (u32 index = 0; index < MAX_ENTRIES; ++index)
+  {
+    MailListEntry& entry = m_data.entries[index];
+    if (GetEntryId(index) == 0 || Common::swap32(entry.wii_cmd) != 0x80010001)
+      continue;
+
+    const u64 sender = Common::swap64(entry.from_friend_code);
+    if (!friend_list.ConfirmFriend(sender))
+      continue;
+
+    const std::string mail_path = GetMailPath(index);
+    const ReceiveList previous = m_data;
+    const u32 message_size = Common::swap32(entry.msg_size);
+    m_data.header.number_of_mail =
+        Common::swap32(Common::swap32(m_data.header.number_of_mail) - 1);
+    m_data.header.total_size_of_messages = Common::swap32(
+        Common::swap32(m_data.header.total_size_of_messages) - message_size);
+    entry = {};
+    m_data.header.next_entry_offset = CalculateFileOffset(index);
+    // Persist removal before deleting its data file. Failed cleanup leaves an unindexed file,
+    // whereas the reverse ordering leaves a live entry pointing to a missing message.
+    if (!WriteReceiveList())
+    {
+      m_data = previous;
+      continue;
+    }
+    DeleteFileFromVFF(RECEIVE_BOX_PATH, mail_path, m_fs);
+    ++processed;
+  }
+
+  return processed;
+}
+}  // namespace IOS::HLE::NWC24::Mail
